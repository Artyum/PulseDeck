{
  "name": "pulsedeck",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "css:build": "tailwindcss -i frontend/static/css/tailwind.css -o frontend/static/css/app.css --minify",
    "css:build:dev": "tailwindcss -i frontend/static/css/tailwind.css -o frontend/static/css/app.css",
    "css:watch": "tailwindcss -i frontend/static/css/tailwind.css -o frontend/static/css/app.css --watch",
    "js:build": "esbuild frontend/js/editor.js --bundle --minify --outfile=frontend/static/js/editor.bundle.js --format=iife --target=es2020",
    "js:watch": "esbuild frontend/js/editor.js --bundle --outfile=frontend/static/js/editor.bundle.js --format=iife --target=es2020 --watch",
    "build": "npm run css:build && npm run js:build",
    "format": "prettier --write \"**/*.{html,css,md,json,js}\"",
    "format:check": "prettier --check \"**/*.{html,css,md,json,js}\"",
    "lint:css": "node --disable-warning=ExperimentalWarning ./node_modules/stylelint/bin/stylelint.mjs \"frontend/static/css/**/*.css\"",
    "lint:dup": "jscpd . --threshold 5"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "esbuild": "^0.28.1",
    "jscpd": "^5.0.14",
    "prettier": "^3.7.0",
    "prettier-plugin-jinja-template": "^2.2.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "stylelint": "^17.14.1",
    "stylelint-config-recommended": "^18.0.0",
    "tailwindcss": "^4.3.0"
  },
  "dependencies": {
    "@tiptap/core": "^3.30.5",
    "@tiptap/markdown": "^3.30.5",
    "@tiptap/pm": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "alpinejs": "^3.16.3"
  }
}

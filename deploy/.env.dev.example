DATABASE_URL=postgresql+psycopg://pulsedeck:pulsedeck@127.0.0.1:5432/pulsedeck

STORAGE_SECRET=dev-pulsedeck-change-me
ENVIRONMENT=development

APP_BASE_URL=http://pulsedeck.lan:8005
ALLOWED_HOSTS=pulsedeck.lan,localhost,127.0.0.1

LOG_DIR=logs
LOG_LEVEL=DEBUG
UPLOAD_DIR=data/uploads

TZ=Europe/Warsaw
ALEMBIC_MAX_RETRIES=20
ALEMBIC_RETRY_DELAY_SECONDS=3

UVICORN_HOST=0.0.0.0
UVICORN_PORT=8005
UVICORN_WORKERS=1
UVICORN_PROXY_HEADERS=false
UVICORN_FORWARDED_ALLOW_IPS=127.0.0.1

SESSION_MAX_AGE_SECONDS=28800
SECURITY_CSRF_ENABLED=true
SECURITY_CSP_ENABLED=true
SECURITY_HSTS_ENABLED=false

AUTH_LOGIN_RATE_LIMIT=10/minute
AUTH_FORGOT_PASSWORD_RATE_LIMIT=5/minute
AUTH_ACTIVATE_RATE_LIMIT=10/minute
AUTH_ADMIN_USER_CREATE_RATE_LIMIT=20/minute
UPLOAD_RATE_LIMIT=20/minute

ADMIN_EMAIL=admin@pulsedeck.lan
ADMIN_PASSWORD=Admin123!
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=PulseDeck

SMTP_SERVER=127.0.0.1
SMTP_PORT=1025
SMTP_USE_SSL=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=PulseDeck <noreply@pulsedeck.local>

MAIL_MIN_INTERVAL_MS=200
MAIL_MAX_PER_HOUR=300
MAIL_MAX_ATTEMPTS=5
MAIL_IDLE_MS=500

AUTH_LINK_TTL_DAYS=7
EMAIL_CONFIRM_TTL_MINUTES=60
TICKET_REOPEN_DAYS=7

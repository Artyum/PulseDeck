DATABASE_URL=postgresql+psycopg://pulsedeck:CHANGE_ME@DB_HOST:5432/pulsedeck

STORAGE_SECRET=CHANGE_ME_TO_LONG_RANDOM_SECRET
ENVIRONMENT=preprod

APP_BASE_URL=https://preprod.pulsedeck.example.com
ALLOWED_HOSTS=preprod.pulsedeck.example.com

LOG_DIR=/app/logs
LOG_LEVEL=INFO
UPLOAD_DIR=/app/data/uploads
# Seed only (portal settings GUI / DB after first bootstrap):
UPLOAD_MAX_IMAGE_BYTES=5242880
UPLOAD_MAX_FILE_BYTES=20971520
UPLOAD_MAX_FILES=3

TZ=Europe/Warsaw
ALEMBIC_MAX_RETRIES=20
ALEMBIC_RETRY_DELAY_SECONDS=3

UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000
UVICORN_WORKERS=1
UVICORN_PROXY_HEADERS=true
UVICORN_FORWARDED_ALLOW_IPS=127.0.0.1

SESSION_MAX_AGE_SECONDS=28800
SECURITY_CSRF_ENABLED=true
SECURITY_CSP_ENABLED=true
SECURITY_HSTS_ENABLED=true

AUTH_LOGIN_RATE_LIMIT=10/minute
AUTH_FORGOT_PASSWORD_RATE_LIMIT=5/minute
AUTH_ACTIVATE_RATE_LIMIT=10/minute
AUTH_ADMIN_USER_CREATE_RATE_LIMIT=20/minute
UPLOAD_RATE_LIMIT=20/minute

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_Strong1!
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=PulseDeck

# Seed only (portal settings GUI / DB after first bootstrap):
SMTP_SERVER=
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

MAIL_MIN_INTERVAL_MS=3000
MAIL_MAX_PER_HOUR=300
MAIL_MAX_ATTEMPTS=5
MAIL_IDLE_MS=1000

# Seed only (portal settings GUI / DB after first bootstrap):
AUTH_LINK_TTL_DAYS=7
EMAIL_CONFIRM_TTL_MINUTES=60
TICKET_REOPEN_DAYS=7
